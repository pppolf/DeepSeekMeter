<Window x:Class="DeepSeekMeter.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="登录 DeepSeek 平台"
        Width="480" Height="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部状态栏（对齐 macOS 版 topBar） -->
        <Border Grid.Row="0" Background="#F3F3F6" BorderBrush="#E0E0E6" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <TextBlock x:Name="StatusText" Text="正在打开官方登录页…" FontSize="11" Foreground="#888888"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="手动粘贴 Token" FontSize="11" Padding="10,3" Margin="0,0,8,0"
                            Background="Transparent" BorderBrush="#CCCCCC" Foreground="#333333"
                            Cursor="Hand" Click="OnManualTokenClick" />
                    <Button Content="用系统浏览器打开" FontSize="11" Padding="10,3"
                            Background="Transparent" BorderBrush="#CCCCCC" Foreground="#333333"
                            Cursor="Hand" Click="OnOpenInBrowserClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内嵌官方登录页 -->
        <wv2:WebView2 x:Name="WebView" Grid.Row="1" />
    </Grid>
</Window>

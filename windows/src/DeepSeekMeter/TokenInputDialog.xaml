<Window x:Class="DeepSeekMeter.TokenInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手动粘贴 Token"
        Width="440" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <StackPanel Margin="18">
        <TextBlock Text="粘贴平台 Token" FontSize="14" FontWeight="SemiBold" />
        <TextBlock Text="登录 platform.deepseek.com 后，从浏览器开发者工具（Application → Local Storage → userToken）复制粘贴到这里。Token 只保存在本机，不会上传到任何第三方。" 
                   FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,8,0,0" />
        <Grid Margin="0,12,0,0">
            <PasswordBox x:Name="TokenBox" Height="32" FontSize="12" />
            <TextBox x:Name="TokenVisibleBox" Height="32" FontSize="12" Visibility="Collapsed" />
        </Grid>
        <CheckBox x:Name="ShowTokenBox" Content="显示 Token" FontSize="11" Foreground="#666666"
                  Checked="OnShowTokenChanged" Unchecked="OnShowTokenChanged" Margin="0,6,0,0" />
        <Grid Margin="0,12,0,0">
            <TextBlock x:Name="HintText" Text="" FontSize="11" Foreground="#C05621" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" FontSize="11" Padding="14,5" Background="Transparent" BorderBrush="#CCCCCC"
                        Foreground="#333333" Cursor="Hand" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="保存" FontSize="11" Padding="14,5" Background="#4D6BFE" Foreground="White"
                        BorderThickness="0" Cursor="Hand" IsDefault="True" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>

<Window x:Class="DeepSeekMeter.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeepSeekMeter"
        Title="DeepSeek Meter"
        Width="360"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        PreviewKeyDown="OnPreviewKeyDown"
        SizeChanged="OnSizeChanged"
        Deactivated="OnDeactivated">

    <Window.Resources>
        <!-- 统一按钮样式 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4D6BFE" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5E79FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#3A3A42" />
            <Setter Property="BorderBrush" Value="#D5D5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0A000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="ButtonBase">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#6B6B76" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- segmented control：裸 RadioButton 改成圆角分段样式 -->
        <Style x:Key="SegButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#6B6B76" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="7,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4D6BFE" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0A4D6BFE" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="#4D6BFE" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#F7F7FA" BorderBrush="#E2E2E8" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.22" Color="#20242C" />
        </Border.Effect>
        <ScrollViewer x:Name="ScrollRoot" VerticalScrollBarVisibility="Auto" MaxHeight="600">
            <StackPanel Margin="16,12,16,14">

                <!-- MARK: 头部（可拖动区） -->
                <Grid x:Name="HeaderBar" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🐳" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Grid.Column="1" Text="DeepSeek Meter" FontSize="13" FontWeight="SemiBold"
                               Foreground="#1A1A20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StatusPill" CornerRadius="9" Padding="8,3" Background="#11000000">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="Gray" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock x:Name="StatusText" Text="未获取" FontSize="10" FontWeight="Medium" Foreground="#6B6B76" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="TimeText" Text="" FontSize="10" Foreground="#9A9AA6" VerticalAlignment="Center" Margin="8,0,8,0" />
                        <ToggleButton x:Name="PinButton" Content="📌" Style="{StaticResource IconButton}"
                                      FontSize="11" ToolTip="固定窗口（点击外部不关闭）" Cursor="Hand"
                                      Width="26" Height="26" Click="OnPinClick" />
                        <Button Content="✕" Style="{StaticResource IconButton}" ToolTip="隐藏"
                                Click="OnCloseClick" Margin="2,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- MARK: 余额 -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="总余额" FontSize="11" Foreground="#6B6B76" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BalanceCurrencyText" Text="¥" FontSize="16" FontWeight="Medium"
                                       Foreground="#6B6B76" VerticalAlignment="Bottom" Margin="0,0,3,6" />
                            <TextBlock x:Name="BalanceValueText" Text="—" FontSize="30" FontWeight="Bold"
                                       Foreground="#1A1A20" />
                        </StackPanel>
                        <TextBlock x:Name="CurrencyCodeText" Text="" FontSize="10" Foreground="#9A9AA6" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0">
                        <TextBlock x:Name="GrantedText" Text="赠送 —" FontSize="11" FontWeight="Medium"
                                   Foreground="#3A3A42" HorizontalAlignment="Right" />
                        <TextBlock x:Name="ToppedUpText" Text="充值 —" FontSize="11" FontWeight="Medium"
                                   Foreground="#3A3A42" HorizontalAlignment="Right" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>

                <!-- MARK: 本月用量 -->
                <Border x:Name="UsageSection" Background="#F1F1F5" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel x:Name="UsageContent">
                            <Grid>
                                <TextBlock x:Name="MonthTitleText" Text="本月用量" FontSize="11" Foreground="#6B6B76" />
                                <TextBlock x:Name="TotalCostText" Text="累计 ¥0.00" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#3A3A42" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="今日费用" FontSize="10" Foreground="#9A9AA6" />
                                    <TextBlock x:Name="TodayCostText" Text="—" FontSize="12" FontWeight="Medium"
                                               Foreground="#1A1A20" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="今日请求" FontSize="10" Foreground="#9A9AA6" />
                                    <TextBlock x:Name="TodayRequestsText" Text="—" FontSize="12" FontWeight="Medium"
                                               Foreground="#1A1A20" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="今日输出" FontSize="10" Foreground="#9A9AA6" />
                                    <TextBlock x:Name="TodayOutputText" Text="—" FontSize="12" FontWeight="Medium"
                                               Foreground="#1A1A20" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="本月请求" FontSize="10" Foreground="#9A9AA6" />
                                    <TextBlock x:Name="MonthRequestsText" Text="—" FontSize="12" FontWeight="Medium"
                                               Foreground="#1A1A20" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="本月输出" FontSize="10" Foreground="#9A9AA6" />
                                    <TextBlock x:Name="MonthOutputText" Text="—" FontSize="12" FontWeight="Medium"
                                               Foreground="#1A1A20" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="缓存命中" FontSize="10" Foreground="#9A9AA6" />
                                    <TextBlock x:Name="CacheHitText" Text="—" FontSize="12" FontWeight="Medium"
                                               Foreground="#1A1A20" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl x:Name="ModelList" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" Foreground="#6B6B76"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="11" Foreground="#6B6B76"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 加载中 -->
                        <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" Orientation="Horizontal">
                            <ProgressBar Width="70" Height="6" IsIndeterminate="True" VerticalAlignment="Center" />
                            <TextBlock Text="加载用量…" FontSize="11" Foreground="#9A9AA6" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 登录引导 -->
                        <StackPanel x:Name="LoginPromptPanel" Visibility="Collapsed">
                            <TextBlock Text="登录后显示余额与用量明细" FontSize="11" Foreground="#6B6B76" />
                            <Button x:Name="LoginPromptButton" Content="一键登录 →" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnLoginPromptClick" />
                        </StackPanel>

                        <!-- 过期/错误提示 -->
                        <StackPanel x:Name="ExpiredPanel" Visibility="Collapsed">
                            <TextBlock x:Name="ExpiredText" Text="平台登录已过期，请重新登录" FontSize="11" Foreground="#6B6B76" TextWrapping="Wrap" />
                            <Button x:Name="ReLoginButton" Content="重新登录 ↻" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnLoginPromptClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- MARK: Token 用量趋势 -->
                <Border x:Name="TrendSection" Background="#F1F1F5" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Token 用量趋势" FontSize="11" Foreground="#6B6B76" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="#E6E6EC" CornerRadius="7" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TrendOutput" Content="输出" GroupName="Trend" Style="{StaticResource SegButton}" Checked="OnTrendChanged" />
                                    <RadioButton x:Name="TrendCacheHit" Content="缓存命中" GroupName="Trend" Style="{StaticResource SegButton}" Checked="OnTrendChanged" />
                                    <RadioButton x:Name="TrendTotal" Content="总量" GroupName="Trend" Style="{StaticResource SegButton}" Checked="OnTrendChanged" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <local:SparklineControl x:Name="TrendChart" Height="46" Margin="0,10,0,0" />
                        <Grid Margin="0,8,0,0">
                            <TextBlock x:Name="TrendTodayText" Text="今日 —" FontSize="10" Foreground="#6B6B76" />
                            <TextBlock x:Name="TrendPeakText" Text="" FontSize="10" Foreground="#6B6B76" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="TrendEmptyText" Text="登录后查看 Token 用量趋势" FontSize="10" Foreground="#9A9AA6"
                                   Margin="0,8,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- MARK: 错误横幅 -->
                <Border x:Name="ErrorBanner" Background="#1AF59E0B" CornerRadius="8" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Text="" FontSize="11" Foreground="#8A5A00" TextWrapping="Wrap" />
                </Border>

                <!-- MARK: 设置 -->
                <Border Background="#F1F1F5" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                        <!-- 平台账号 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="平台账号" FontSize="11" Foreground="#6B6B76" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="AccountStatusText" Text="未登录" FontSize="11" Foreground="#6B6B76" />
                                <TextBlock x:Name="AccountNameText" Text="" FontSize="10" Foreground="#9A9AA6" Margin="6,0,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="120" />
                            </StackPanel>
                            <Button x:Name="LoginButton" Grid.Column="2" Content="登录" Style="{StaticResource SecondaryButton}"
                                    Padding="10,4" Click="OnLoginPromptClick" />
                        </Grid>

                        <!-- 刷新间隔 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="刷新间隔" FontSize="11" Foreground="#6B6B76" VerticalAlignment="Center" />
                            <Border Grid.Column="1" HorizontalAlignment="Left" Background="#E6E6EC" CornerRadius="7" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Interval15" Content="15秒" GroupName="Interval" Style="{StaticResource SegButton}" Checked="OnIntervalChanged" />
                                    <RadioButton x:Name="Interval30" Content="30秒" GroupName="Interval" Style="{StaticResource SegButton}" Checked="OnIntervalChanged" />
                                    <RadioButton x:Name="Interval60" Content="1分" GroupName="Interval" Style="{StaticResource SegButton}" Checked="OnIntervalChanged" />
                                    <RadioButton x:Name="Interval300" Content="5分" GroupName="Interval" Style="{StaticResource SegButton}" Checked="OnIntervalChanged" />
                                    <RadioButton x:Name="Interval600" Content="10分" GroupName="Interval" Style="{StaticResource SegButton}" Checked="OnIntervalChanged" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 开机自启 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="开机自启" FontSize="11" Foreground="#6B6B76" VerticalAlignment="Center" />
                            <CheckBox x:Name="LaunchAtLoginBox" Grid.Column="1" Content="登录 Windows 时自动启动"
                                      FontSize="11" Foreground="#3A3A42" VerticalAlignment="Center"
                                      Checked="OnLaunchAtLoginChanged" Unchecked="OnLaunchAtLoginChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- MARK: 底部 -->
                <Grid Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource SecondaryButton}" Click="OnRefreshClick" />
                        <Button x:Name="LogoutButton" Content="退出登录" FontSize="11" Padding="8,5" Background="Transparent"
                                BorderThickness="0" Foreground="#9A9AA6" Cursor="Hand" Click="OnLogoutClick" Margin="10,0,0,0" />
                    </StackPanel>
                    <Button Content="退出" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="OnQuitClick" />
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>

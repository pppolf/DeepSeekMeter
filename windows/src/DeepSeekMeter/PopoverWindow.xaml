<Window x:Class="DeepSeekMeter.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeepSeekMeter"
        Title="DeepSeek Meter"
        Width="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Deactivated="OnDeactivated">

    <Border CornerRadius="14" Background="#F7F7F9" BorderBrush="#E2E2E8" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#333333" />
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
            <StackPanel Margin="16">

                <!-- MARK: 头部 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🐳" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Grid.Column="1" Text="DeepSeek Meter" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StatusPill" CornerRadius="9" Padding="8,3" Background="#22000000">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="Gray" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock x:Name="StatusText" Text="未获取" FontSize="10" FontWeight="Medium" Foreground="#666666" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="TimeText" Text="" FontSize="10" Foreground="#999999" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- MARK: 余额 -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="总余额" FontSize="11" Foreground="#888888" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BalanceCurrencyText" Text="¥" FontSize="16" FontWeight="Medium" Foreground="#888888" VerticalAlignment="Bottom" Margin="0,0,3,6" />
                            <TextBlock x:Name="BalanceValueText" Text="—" FontSize="30" FontWeight="Bold" Foreground="#111111" />
                        </StackPanel>
                        <TextBlock x:Name="CurrencyCodeText" Text="" FontSize="10" Foreground="#AAAAAA" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0">
                        <TextBlock x:Name="GrantedText" Text="赠送 —" FontSize="11" FontWeight="Medium" Foreground="#555555" HorizontalAlignment="Right" />
                        <TextBlock x:Name="ToppedUpText" Text="充值 —" FontSize="11" FontWeight="Medium" Foreground="#555555" HorizontalAlignment="Right" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>

                <!-- MARK: 本月用量 -->
                <Border x:Name="UsageSection" Background="#11000000" CornerRadius="10" Padding="10" Margin="0,14,0,0">
                    <StackPanel>
                        <!-- 登录后的内容 -->
                        <StackPanel x:Name="UsageContent">
                            <Grid>
                                <TextBlock x:Name="MonthTitleText" Text="本月用量" FontSize="11" Foreground="#888888" />
                                <TextBlock x:Name="TotalCostText" Text="累计 ¥0.00" FontSize="11" FontWeight="SemiBold" Foreground="#333333" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="今日费用" FontSize="10" Foreground="#AAAAAA" />
                                    <TextBlock x:Name="TodayCostText" Text="—" FontSize="12" FontWeight="Medium" Foreground="#333333" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="今日请求" FontSize="10" Foreground="#AAAAAA" />
                                    <TextBlock x:Name="TodayRequestsText" Text="—" FontSize="12" FontWeight="Medium" Foreground="#333333" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="今日输出" FontSize="10" Foreground="#AAAAAA" />
                                    <TextBlock x:Name="TodayOutputText" Text="—" FontSize="12" FontWeight="Medium" Foreground="#333333" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="本月请求" FontSize="10" Foreground="#AAAAAA" />
                                    <TextBlock x:Name="MonthRequestsText" Text="—" FontSize="12" FontWeight="Medium" Foreground="#333333" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="本月输出" FontSize="10" Foreground="#AAAAAA" />
                                    <TextBlock x:Name="MonthOutputText" Text="—" FontSize="12" FontWeight="Medium" Foreground="#333333" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="缓存命中" FontSize="10" Foreground="#AAAAAA" />
                                    <TextBlock x:Name="CacheHitText" Text="—" FontSize="12" FontWeight="Medium" Foreground="#333333" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl x:Name="ModelList" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" Foreground="#888888"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="11" Foreground="#888888"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 加载中 -->
                        <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" Orientation="Horizontal">
                            <ProgressBar Width="70" Height="6" IsIndeterminate="True" VerticalAlignment="Center" />
                            <TextBlock Text="加载用量…" FontSize="11" Foreground="#AAAAAA" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 登录引导 -->
                        <StackPanel x:Name="LoginPromptPanel" Visibility="Collapsed">
                            <TextBlock Text="登录后显示余额与用量明细" FontSize="11" Foreground="#888888" />
                            <Button x:Name="LoginPromptButton" Content="一键登录 →" FontSize="11" Padding="10,4" Margin="0,8,0,0"
                                    HorizontalAlignment="Left" Background="#4D6BFE" Foreground="White" BorderThickness="0"
                                    Cursor="Hand" Click="OnLoginPromptClick" />
                        </StackPanel>

                        <!-- 过期/错误提示 -->
                        <StackPanel x:Name="ExpiredPanel" Visibility="Collapsed">
                            <TextBlock x:Name="ExpiredText" Text="平台登录已过期，请重新登录" FontSize="11" Foreground="#888888" TextWrapping="Wrap" />
                            <Button x:Name="ReLoginButton" Content="重新登录 ↻" FontSize="11" Padding="10,4" Margin="0,8,0,0"
                                    HorizontalAlignment="Left" Background="Transparent" BorderBrush="#CCCCCC" Foreground="#333333"
                                    Cursor="Hand" Click="OnLoginPromptClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- MARK: Token 用量趋势 -->
                <Border x:Name="TrendSection" Background="#11000000" CornerRadius="10" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Token 用量趋势" FontSize="11" Foreground="#888888" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <RadioButton x:Name="TrendOutput" Content="输出" GroupName="Trend" FontSize="10" Checked="OnTrendChanged" Margin="0,0,10,0" />
                                <RadioButton x:Name="TrendCacheHit" Content="缓存命中" GroupName="Trend" FontSize="10" Checked="OnTrendChanged" Margin="0,0,10,0" />
                                <RadioButton x:Name="TrendTotal" Content="总量" GroupName="Trend" FontSize="10" Checked="OnTrendChanged" />
                            </StackPanel>
                        </Grid>
                        <local:SparklineControl x:Name="TrendChart" Height="46" Margin="0,10,0,0" />
                        <Grid Margin="0,8,0,0">
                            <TextBlock x:Name="TrendTodayText" Text="今日 —" FontSize="10" Foreground="#888888" />
                            <TextBlock x:Name="TrendPeakText" Text="" FontSize="10" Foreground="#888888" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="TrendEmptyText" Text="登录后查看 Token 用量趋势" FontSize="10" Foreground="#AAAAAA" Margin="0,8,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- MARK: 错误横幅 -->
                <Border x:Name="ErrorBanner" Background="#24F59E0B" CornerRadius="8" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Text="" FontSize="11" Foreground="#8A5A00" TextWrapping="Wrap" />
                </Border>

                <!-- MARK: 设置 -->
                <Border Background="#11000000" CornerRadius="10" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                        <!-- 平台账号 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="平台账号" FontSize="11" Foreground="#888888" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="AccountStatusText" Text="未登录" FontSize="11" Foreground="#888888" />
                                <TextBlock x:Name="AccountNameText" Text="" FontSize="10" Foreground="#AAAAAA" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button x:Name="LoginButton" Grid.Column="2" Content="登录" FontSize="11" Padding="12,4"
                                    Background="#4D6BFE" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    Click="OnLoginPromptClick" />
                        </Grid>

                        <!-- 刷新间隔 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="刷新间隔" FontSize="11" Foreground="#888888" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="Interval15" Content="15秒" GroupName="Interval" FontSize="10" Checked="OnIntervalChanged" Margin="0,0,8,0" />
                                <RadioButton x:Name="Interval30" Content="30秒" GroupName="Interval" FontSize="10" Checked="OnIntervalChanged" Margin="0,0,8,0" />
                                <RadioButton x:Name="Interval60" Content="1分" GroupName="Interval" FontSize="10" Checked="OnIntervalChanged" Margin="0,0,8,0" />
                                <RadioButton x:Name="Interval300" Content="5分" GroupName="Interval" FontSize="10" Checked="OnIntervalChanged" Margin="0,0,8,0" />
                                <RadioButton x:Name="Interval600" Content="10分" GroupName="Interval" FontSize="10" Checked="OnIntervalChanged" />
                            </StackPanel>
                        </Grid>

                        <!-- 开机自启 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="开机自启" FontSize="11" Foreground="#888888" VerticalAlignment="Center" />
                            <CheckBox x:Name="LaunchAtLoginBox" Grid.Column="1" Content="登录 Windows 时自动启动" FontSize="11" Foreground="#444444"
                                      VerticalAlignment="Center" Checked="OnLaunchAtLoginChanged" Unchecked="OnLaunchAtLoginChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- MARK: 底部 -->
                <Grid Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RefreshButton" Content="刷新" FontSize="11" Padding="12,4" Background="Transparent"
                                BorderBrush="#CCCCCC" Foreground="#333333" Cursor="Hand" Click="OnRefreshClick" />
                        <Button x:Name="LogoutButton" Content="退出登录" FontSize="11" Padding="8,4" Background="Transparent"
                                BorderThickness="0" Foreground="#999999" Cursor="Hand" Click="OnLogoutClick" Margin="10,0,0,0" />
                    </StackPanel>
                    <Button Content="退出" FontSize="11" Padding="12,4" Background="Transparent" BorderBrush="#CCCCCC"
                            Foreground="#333333" Cursor="Hand" HorizontalAlignment="Right" Click="OnQuitClick" />
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
